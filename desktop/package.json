{
  "name": "mockingbird-desktop",
  "productName": "Mockingbird",
  "version": "1.1.0",
  "description": "Mockingbird by Thunderbird \u2014 voice dictation, reviewed rewrites and saved responses.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node tools/smoke.js",
    "icons": "node tools/make-icons.js",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist": "electron-builder --mac --win"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.thunderbird.mockingbird",
    "productName": "Mockingbird",
    "files": [
      "main.js",
      "preload.js",
      "overlay.html",
      "settings.html",
      "assets/**/*",
      "settings-preload.js",
      "settings.js",
      "settings.css",
      "overlay.js"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Mockingbird uses the microphone so you can dictate instead of typing.",
        "NSAppleEventsUsageDescription": "Mockingbird sends a paste keystroke so dictated text lands where your cursor is.",
        "LSUIElement": true
      },
      "artifactName": "Mockingbird-mac.${ext}",
      "notarize": true
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png",
      "artifactName": "Mockingbird-win.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png",
      "category": "Utility"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ThunderbirdAgency",
        "repo": "CT-Speak-It"
      }
    ],
    "forceCodeSigning": true
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
