# Public HTTPS origin of this deployment (no trailing slash or path).
MOCKINGBIRD_PUBLIC_URL=
MOCKINGBIRD_HUB_URL=
MOCKINGBIRD_SUPPORT_EMAIL=
# Reuse the Hub's Clerk instance; configure this site as an allowed frontend.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_AUTHORIZED_PARTIES=
# Optional PEM public key for networkless JWT verification.
CLERK_JWT_KEY=
# Verified Clerk user IDs allowed to create/revoke gift codes, comma-separated.
MOCKINGBIRD_ADMIN_USER_IDS=
# Hub database: apply db/migrations/20260905_consumer.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Configure at least one speech provider. Groq is selected first, then Deepgram, then OpenAI.
GROQ_API_KEY=
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MOCKINGBIRD_MODEL=claude-sonnet-4-6
# Optional approved-memory global kill switch: off.
MOCKINGBIRD_LEARNING=on
# Explicit web origins, comma-separated. Include the public URL and Hub origin if embedding.
ALLOWED_ORIGINS=
# Use TEST keys until checkout/webhooks have been verified end to end.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Enable downloads only after signed release verification and publication.
MOCKINGBIRD_MAC_DOWNLOAD_URL=
MOCKINGBIRD_WINDOWS_DOWNLOAD_URL=
